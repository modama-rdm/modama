[Unit]
Description=SSH-based VPN to iff1020 to forward port 445 to 172.17.0.250 (regular CIFS), 1445 to 172.17.0.251:445 (smbdrop)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -c aes128-ctr -o ServerAliveInterval=60 -o ExitOnForwardFailure=yes -N -L 172.17.0.251:445:localhost:1445 -L 172.17.0.250:445:localhost:445 -i /var/local/sshvpn/beatepivpn moellenstedtvpn@iff1020.iff.kfa-juelich.de
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target

