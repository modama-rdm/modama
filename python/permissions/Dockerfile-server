FROM debian:stable-slim
LABEL Dieter Weber <d.weber@fz-juelich.de>

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=target=/var/lib/apt/lists,type=cache,sharing=locked \
    apt-get -y update && apt-get -y upgrade && apt-get -y install sudo acl libacl1-dev inotify-tools python3 python3-pylibacl libpam0g libpam-runtime libpam-sss libnss-sss python3-sss python3-pip

RUN groupadd testprimary && groupadd testerc && groupadd testholo && groupadd testprivate && groupadd testshare

RUN adduser testdieter --gecos "" --no-create-home --disabled-login --ingroup testprimary && adduser testdieter testerc && adduser testdieter testholo && adduser testdieter testshare
RUN adduser testalex --gecos "" --no-create-home --disabled-login --ingroup testprimary && adduser testalex testerc && adduser testalex testholo && adduser testalex testshare
RUN adduser testthibaud --gecos "" --no-create-home --disabled-login --ingroup testprimary && adduser testthibaud testerc && adduser testthibaud testholo && adduser testthibaud testprivate 
RUN adduser testpenghan --gecos "" --no-create-home --disabled-login --ingroup testprimary && adduser testpenghan testerc && adduser testpenghan testholo && adduser testpenghan testprivate
RUN adduser testjanghyun --gecos "" --no-create-home --disabled-login --ingroup testprimary && adduser testjanghyun testerc && adduser testjanghyun testprivate && adduser testjanghyun testshare
RUN echo "1234\n1234" | passwd testdieter
RUN echo "abcd\nabcd" | passwd testalex

# Debug and dev stuff, remove for production
RUN --mount=type=cache,target=/root/.cache python3 -m pip install jupyter notebook

COPY . /code

RUN --mount=type=cache,target=/root/.cache python3 -m pip install /code/permissions-client/
RUN --mount=type=cache,target=/root/.cache python3 -m pip install /code/permissions/

WORKDIR /code/permissions/

CMD /code/permissions/test-server.sh
