{% extends "base.html.j2" %}

{% block content %}

{% include '_header.html.j2' %}

{% from "_projecthelpers.html.j2" import copypath %}

{% macro render_row(p) %}
    <tr>
        <td><a href="{{ url_for("projectdetails", name=p.name) }}">{{ p.name }}</a></td>
        <td>{{ p.mtime|format_unixtime }}</td>
        <td>{{ p.owner }}</td>
        <td>
            {% for m in p.members %}
                {{ m }}
            {% endfor %}
        </td>
        <td><a href="{{ url_for('browse', path=p | canonical_path) }}">{{ p | canonical_path }}</td>
        <td>{{ copypath(p | canonical_path) }}</td>
    </tr>
{% endmacro %}

{% macro render_share(s) %}
    <tr>
        <td><a href="{{ url_for("projectdetails", name=s.project) }}">{{ s.project }}</a></td>
        <td>{{ s.dsname }}</td>
        <td><a href="{{ url_for('share_dataset', name=s.project, dataset=s.dsname) }}" class="mui-btn mui-btn--small mui-btn--raised">
                    Manage ingest...
                </a>
        </td>
    </tr>
{% endmacro %}

<div class="mui-panel">
    <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / Management</p>
    <h1>Projects</h1>

    {% include '_flash.html.j2' %}

    <table class="mui-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Modified</th>
                <th>Owner</th>
                <th>Members</th>
                <th>Browse</th>
                <th>Copy URL</th>
            </tr>
        </thead>
        <tbody>
            <tr><th class="subheading" colspan="4">Own</th></tr>
            {% if ownprojects %}
                {% for project in ownprojects %}
                    {{ render_row(project) }}
                {% endfor %}
            {% else %}
                <tr><td colspan="4">(None)</td></tr>
            {% endif %}

            <tr><th class="subheading" colspan="4">Member</th></tr>
            {% if memberprojects %}
                {% for project in memberprojects %}
                    {{ render_row(project) }}
                {% endfor %}
            {% else %}
                <tr><td colspan="4">(None)</td></tr>
            {% endif %}

            <tr><th class="subheading" colspan="4">Other</th></tr>
            {% if otherprojects %}
                {% for project in otherprojects %}
                    {{ render_row(project) }}
                {% endfor %}
            {% else %}
                <tr><td colspan="4">(None)</td></tr>
            {% endif %}
        </tbody>
    </table>

    {% if shares %}
    <h1>Active ingest sessions</h1>

    <table class="mui-table">
        <thead>
            <tr>
                <th>Project</th>
                <th>Session</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
                {% for shares in shares %}
                    {{ render_share(shares) }}
                {% endfor %}
        </tbody>
    </table>
    {% endif %}
    <p>
        <a href="{{ url_for("add_project") }}" class="mui-btn mui-btn--raised">
            Create Project...
        </a>
    </p>

</div>

{% endblock content %}