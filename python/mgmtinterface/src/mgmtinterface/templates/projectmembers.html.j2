{% extends "base.html.j2" %}

{% from "_formhelpers.html.j2" import render_field %}
{% from "_projecthelpers.html.j2" import render_members, navbar, cancel %}

{% block styles %}
<link href="{{ url_for('static', filename='select2-4.0.13/dist/css/select2.min.css') }}" rel="stylesheet" />
{# Fix width of multiple select element -- broker compromise between MUI and Select2 #}
<style type="text/css">
.js-example-basic-multiple select {
  width: 100%;
}
</style>
{% endblock styles %}

{% block content %}

{% include '_header.html.j2' %}

<div class="mui-panel">
  {{ navbar(project, "Members") }}
  <h1>Manage members of project "{{ project['name'] }}"</h1>
  
  {% include '_flash.html.j2' %}

  <p>Members can create files and folders within a project.
  All members of the 'iff' group in the PGI-JCNS-TA user management
  can be project members in the data management system. Under the hood,
  project membership and write access for user-created projects is managed through
  <a href="https://www.redhat.com/sysadmin/linux-access-control-lists">POSIX ACLs</a>.
  </p>
  
  <form
      method=post
      action="{{ url_for("project_members", name=project.name) }}"
      class="mui-form"
  >
    {{ form.csrf_token }}
    {% with field = form.members %}
      <div class="mui-textfield js-example-basic-multiple">
        {{ field.label }}
        {{ field|safe }}
        {% if field.errors %}
          <ul class=errors>
          {% for error in field.errors %}
            <li>{{ error }}</li>
          {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endwith %}
    <p>
      <input type="submit" class="mui-btn mui-btn--raised mui-btn--primary" value="Change project members"/>
      {{ cancel(project) }}
    </p>
  </form>
</div>
{% endblock content %}

{% block javascript %}
<script src="{{ url_for('static', filename='jquery-3.6.0.slim.min.js') }}"></script>
<script src="{{ url_for('static', filename='select2-4.0.13/dist/js/select2.min.js') }}"></script>
<script>
$(document).ready(function() {
    $('.js-example-basic-multiple select').select2();
});
</script>
{% endblock javascript %}