{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}


<div class="mui-panel">
  <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / <a href="{{ url_for("browse") }}">Browse</a></p>
  <h1>{% if components.info.isdir %}Folder{% else %}File{% endif %} details</h1>
  {% include '_flash.html.j2' %}
  <p>Path:
    {% for (full, tail) in components.path_pyramid %}
      / <a href="{{ url_for('browse', path=full) }}">{{ tail }}</a>
    {% endfor %}
  </p>

  
  <p>Name: {{ components.info.name }}</p>
  <p>Created: {{ components.info.created }}</p>
  <p>Modified: {{ components.info.modified }}</p>
  <p>Size (Bytes): {{ components.info.size }}</p>
  
  <p>Project: 
    {% if components.info.project %}
      <a href="{{ url_for("projectdetails", name=components.info.project) }}">{{ components.info.project }}</a>
    {% else %}
      None
    {% endif %}
  </p>
  

  {% if components.members %}
      <h2>Browse</h2>
      <table class="mui-table">
        <thead>
            <tr>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            {% for m in components.members %}
            <tr>
                <td><a href="{{ url_for('browse', path=m.path) }}">{% if m.isdir %}📁 {% else %}📄 {% endif %}{{ m.name }}</a></td>
            </tr>
            {% endfor %}
        </tbody>
      </table>
    {% endif %}
</div>
{% endblock content %}