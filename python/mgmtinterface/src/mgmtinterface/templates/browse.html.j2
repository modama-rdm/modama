{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}
{% from "_projecthelpers.html.j2" import copybutton, copypath %}


<div class="mui-panel">
  <p>
    <a href="https://er-c-data.fz-juelich.de">ER-C-Data</a>
    / <a href="{{ url_for("project") }}">Management</a>
    / <a href="{{ url_for("browse") }}">Browse</a>
  </p>
  {% include '_flash.html.j2' %}
  <h1>{% if components.info.isdir %}📁 {% else %}📄 {% endif %} {{ components.info.name }} {{ copypath(components.path) }}</h1>
  <dl class="details-list">
    <dt class="mui--text-dark-secondary">Project</dt>
    <dd class="details-list__definition">
      {% if components.info.project %}
        <a href="{{ url_for("projectdetails", name=components.info.project) }}">{{ components.info.project }}</a>
      {% else %}
        None
      {% endif %}
    </dd>
    <dt class="mui--text-dark-secondary">Created</dt><dd class="details-list__definition">{{ components.info.created }}</dd>
    <dt class="mui--text-dark-secondary">Modified</dt><dd class="details-list__definition">{{ components.info.modified }}</dd>
    {% if components.info.isdir %}
      <dt class="mui--text-dark-secondary">Entries</dt><dd class="details-list__definition">{{ components.info.member_count }}</dd>
    {% else %}
      <dt class="mui--text-dark-secondary">Size</dt><dd class="details-list__definition" title="{{ components.info.size }} bytes">{{ components.info.size|format_filesize }}</dd>
    {% endif %}
  </dl>

  <h2>Access this file or folder</h2>
  <div class="cta">
    <div class="cta__item mui-panel">
        <div>
            <h3>Nextcloud</h3>
            <p>Access folder with Nextcloud</p>
        </div>
        <p>
            <a class="mui-btn mui-btn--raised mui-btn--primary" href="{{ components.path | nextcloudlink(components.info.isdir) }}" target="_blank">
                Browse in Nextcloud
            </a>
        </p>
    </div>
    <div class="cta__item mui-panel">
        <div>
            <h3>JupyterHub</h3>
            <p>Access folder in JupyterHub</p>
        </div>
        <p>
            <a class="mui-btn mui-btn--raised mui-btn--primary" href="{{ components.path | jupyterlink(components.info.isdir) }}" target="_blank">
                🛡️Open JupyterHub
            </a>
        </p>
    </div>
    <div class="cta__item mui-panel">
        <div>
            <h3>LiberTEM</h3>
            <p>Open file or folder with LiberTEM</p>
        </div>
        <p>
            <a class="mui-btn mui-btn--raised mui-btn--primary" href="{{ components.path | libertemlink }}" target="_blank">
                🛡️Open in LiberTEM
            </a>
        </p>
    </div>

{% if not components.info.isdir %}
    <div class="cta__item mui-panel">
        <div>
            <h3>Image viewer</h3>
            <p>Open file in an image viewer</p>
        </div>
        <p>
            <a class="mui-btn mui-btn--raised mui-btn--primary" href="{{ components.path | imageviewerlink }}" target="_blank">
                🛡️Open in image viewer
            </a>
        </p>
    </div>
{% endif %}

    <div class="cta__item mui-panel">
        <div>
            <h3>SampleDB</h3>
            <p>Search in SampleDB</p>
        </div>
        <p>
            <a class="mui-btn mui-btn--raised mui-btn--primary" href="{{ components.path | sampledbsearch }}" target="_blank">
                🛡️Search in SampleDB
            </a>
        </p>
    </div>
  </div>

  <p>
    <a href="https://en.wikipedia.org/wiki/Rsync">Rsync</a> push to er-c-data with optimized settings:
    <div style="display: flex; gap: 0.5em">
      <input id="rsync" value="{{ components.path | rsync(components.info.isdir) }}" readonly style="flex-grow: 1"/>
      {{ copybutton(components.path | rsync(components.info.isdir)) }}
    </div>
  </p>
  <p>
    <a href="https://en.wikipedia.org/wiki/Secure_file_transfer_program">SFTP</a> with optimized settings:
    <div style="display: flex; gap: 0.5em">
      <input id="sftp" value="{{ components.path | sftp(components.info.isdir) }}" readonly style="flex-grow: 1"/>
      {{ copybutton(components.path | sftp(components.info.isdir)) }}
    </div>
  </p>
  <p>
    <a href="https://er-c-data.fz-juelich.de/#use-filesystem">SMB (Windows)</a>:
    <div style="display: flex; gap: 0.5em">
      <input id="smb" value="{{ components.path | main_smbpath }}" readonly style="flex-grow: 1"/>
      {{ copybutton(components.path | main_smbpath) }}
    </div>
  </p>

  <h2 id='browse'>Browse</h2>
  {% if components.members %}
      <p>
        {% for (full, tail) in components.path_pyramid %}
          / <a href="{{ url_for('browse', path=full) }}#browse">{{ tail }}</a>
        {% endfor %}
        {{ copypath(components.path) }}
      </p>
      <table class="mui-table mui-table--bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th><!-- Copy URL --></th>
                <th>Nextcloud</th>
                <th>JupyterHub</th>
                <th>LiberTEM</th>
                <th>View</th>
                <th>SampleDB</th>
            </tr>
        </thead>
        <tbody>
            {% for m in components.members %}
            <tr>
                <td>
                  <a href="{{ url_for('browse', path=m.path) }}#browse">{% if m.isdir %}📁 {% else %}📄 {% endif %}{{ m.name }}</a>
                </td>
                <td>{% if m.name != '..' %}{{ copypath(m.path) }}{% endif %}</td>
                {% if m.name != '..' %}
                  {% if m.isdir %}
                    <td><a target="_blank" href="{{ m.path | nextcloudlink(m.isdir) }}">🔗➡️</a></td>
                    <td><a target="_blank" href="{{ m.path | jupyterlink(m.isdir) }}">🔗➡️</a></td>
                  {% else %}
                    <td></td>
                    <td></td>
                  {% endif %}
                  <td><a target="_blank" href="{{ m.path | libertemlink }}">🔗➡️</a></td>
                  {% if m.isdir %}
                    <td></td>
                  {% else %}
                    <td><a target="_blank" href="{{ m.path | imageviewerlink }}">🔗➡️</a></td>
                  {% endif %}
                  <td><a target="_blank" href="{{ m.path | sampledbsearch }}">🔗➡️</a></td>
                {% else %}
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                {% endif %}
            </tr>
            {% endfor %}
        </tbody>
      </table>
    {% endif %}
</div>
{% endblock content %}
