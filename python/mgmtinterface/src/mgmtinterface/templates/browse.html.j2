{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}

{% from "_projecthelpers.html.j2" import render_members, render_datasets, navbar_short %}


<div class="mui-panel">
  <h1>Path "{{ components.path }}"</h1>
  
  {% include '_flash.html.j2' %}
  <p>Created: {{ components.info.created }}</p>
  <p>Modified: {{ components.info.modified }}</p>
  <p>Size (Bytes): {{ components.info.size }}</p>

  {% if components.members %}
      <table class="mui-table">
        <thead>
            <tr>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            {% for m in components.members %}
            <tr>
                <td><a href="{{ url_for('browse', path=m.path) }}">{{ m.name }}</a></td>
            </tr>
            {% endfor %}
        </tbody>
      </table>
    {% else %}
      (None)
    {% endif %}
</div>
{% endblock content %}