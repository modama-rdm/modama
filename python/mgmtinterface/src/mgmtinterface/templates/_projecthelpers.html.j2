{% macro navbar(project, topic) %}
    <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / <a href="{{ url_for("index") }}">Projects</a> / <a href="{{ url_for("project", name=project.name) }}">{{ project.name }}</a> / {{ topic }}</p>
{% endmacro %}

{% macro navbar_short(topic) %}
    <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / <a href="{{ url_for("index") }}">Projects</a> / {{ topic }}</p>
{% endmacro %}

{% macro render_members(project, current_user) %}      
      {% for m in project.members %}
        {{ m }}{{ ", " if not loop.last else "" }}
      {% endfor %}
{% endmacro %}

{% macro render_datasets(project, datasets, current_user) %}
    {% if datasets %}
      <table class="mui-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Modified</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for d in datasets %}
            <tr>
                <td>{{ d.name }}</td>
                <td>{{ d.mtime|format_unixtime }}</td>
                <td>
                  {% if d.immutable %}sealed{% else %}writable{% endif %}{% if d.shared %}, ingest active{% endif %}
                </td>
                {% if not d.immutable and (current_user.user_id in project.members or current_user.user_id == project.owner) %}
                <td>
                <a href="{{ url_for('seal_dataset', name=project.name, dataset=d.name) }}">
                    <button class="mui-btn mui-btn--small mui-btn--raised">Seal...</button>
                </a>
                {% endif %}
                {% if (not d.immutable or d.shared) and (current_user.user_id in project.members or current_user.user_id == project.owner) %}
                <a href="{{ url_for('share_dataset', name=project.name, dataset=d.name) }}">
                    <button class="mui-btn mui-btn--small mui-btn--raised">Manage ingest...</button>
                </a>
                {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
      </table>
    {% else %}
      (None)
    {% endif %}
{% endmacro %}

{% macro cancel(project, action="Cancel") %}
        <a href="{{ url_for("project", name=project.name) }}">
            <button type="button" class="mui-btn mui-btn--raised">{{ action }}</button>
        </a>
{% endmacro %}