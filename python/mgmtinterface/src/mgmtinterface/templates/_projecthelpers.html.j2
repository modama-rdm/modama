{% macro navbar(project, topic) %}
    <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / <a href="{{ url_for("project") }}">Projects</a> / <a href="{{ url_for("projectdetails", name=project.name) }}">{{ project.name }}</a> / {{ topic }}</p>
{% endmacro %}

{% macro navbar_short(topic) %}
    <p><a href="https://er-c-data.fz-juelich.de">ER-C-Data</a> / <a href="{{ url_for("project") }}">Projects</a> / {{ topic }}</p>
{% endmacro %}

{% macro render_members(project, current_user) %}      
      {% for m in project.members %}
        {{ m }}{{ ", " if not loop.last else "" }}
      {% endfor %}
{% endmacro %}

{% macro render_datasets(project, datasets, current_user) %}
    {% if datasets %}
      <table class="mui-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Browse</th>
                <th>Modified</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for d in datasets %}
            <tr>
                <td>{{ d.name }}</td>
                <td>
                  <a href="{{ url_for('browse', path=project | canonical_path(d.name)) }}">
                    🔗➡️
                  </a>
                </td>
                <td>{{ d.mtime|format_unixtime }}</td>
                <td>
                  {% if d.immutable %}sealed{% else %}writable{% endif %}{% if d.shared %}, ingest active{% endif %}
                </td>
                <td>
                {% if not d.immutable and (current_user.user_id in project.members or current_user.user_id == project.owner) %}
                <a href="{{ url_for('seal_dataset', name=project.name, dataset=d.name) }}" class="mui-btn mui-btn--small mui-btn--raised">
                    Seal...
                </a>
                {% endif %}
                {% if (not d.immutable or d.shared) and (current_user.user_id in project.members or current_user.user_id == project.owner) %}
                <a href="{{ url_for('share_dataset', name=project.name, dataset=d.name) }}" class="mui-btn mui-btn--small mui-btn--raised">
                    Manage ingest...
                </a>
                {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
      </table>
    {% else %}
      (None)
    {% endif %}
{% endmacro %}

{% macro cancel(project, action="Cancel") %}
        <a href="{{ url_for("projectdetails", name=project.name) }}" class="mui-btn mui-btn--raised">
          {{ action }}
        </a>
{% endmacro %}

{% macro copybutton(text) %}
  <a style="cursor: pointer" data-to-copy="{{ text }}" class="copybutton" title="Copy to clipboard: {{ text }}">
    <i class="fa-regular fa-copy"/></i>
  </a>
{% endmacro %}

{% macro copypath(path) %}
  {% set url = url_for('browse', _external=True) %}
  <a href="{{ url|add_path_to_query(path) }}"
        data-to-copy="{{ url }}"
        class="copybutton" title="Copy to clipboard: {{ url }}">
    <i class="fa-regular fa-copy"/></i>
  </a>
{% endmacro %}
