{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}

{% from "_projecthelpers.html.j2" import render_members, render_datasets %}


<div class="mui-panel">
  <p><a style="margin-right: 10px;" href="https://er-c-data.fz-juelich.de">Data management overview</a> | <a style="margin-left: 10px;"href="{{ url_for("index") }}">Projects</a></p>
  <h1>Project "{{ project.name }}"</h1>
  
  {% include '_flash.html.j2' %}
  <p>Owner: {{ project.owner }}</p>
  <p>Created: {{ project.ctime|format_unixtime }}</p>
  <p>Modified: {{ project.mtime|format_unixtime }}</p>
  <p>Size (Bytes): {{ project.usage_bytes }}</p>
  <p>Members:
    {{ render_members(project, current_user) }}
  </p>
  {% if current_user.user_id == project.owner %}
    <p>
      <a href="{{ url_for("project_members", name=project.name) }}">
        <button type="button" class="mui-btn mui-btn--raised">
          Manage project members...
        </button>
      </a>
    </p>
  {% endif %}

  <h2>Sessions</h2>

  {{ render_datasets(project, datasets, current_user)}}

  {% if current_user.user_id in project.members or current_user.user_id == project.owner %}
    <p>
      <a href="{{ url_for("create_dataset", name=project.name) }}">
        <button type="button" class="mui-btn mui-btn--raised">
          Create session...
        </button>
      </a>
    </p>
  {% endif %}
</div>
{% endblock content %}