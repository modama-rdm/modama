{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}

{% from "_projecthelpers.html.j2" import render_members, render_datasets, navbar_short %}


<div class="mui-panel">
  {{ navbar_short(project.name) }}
  <h1>Project "{{ project.name }}"</h1>
  
  {% include '_flash.html.j2' %}

  <dl class="details-list">
    <dt class="mui--text-dark-secondary">Owner</dt><dd class="details-list__definition">{{ project.owner }}</dd>
    <dt class="mui--text-dark-secondary">Created</dt><dd class="details-list__definition">{{ project.ctime|format_unixtime }}</dd>
    <dt class="mui--text-dark-secondary">Modified</dt><dd class="details-list__definition">{{ project.mtime|format_unixtime }}</dd>
    <dt class="mui--text-dark-secondary">Size (Bytes)</dt><dd class="details-list__definition"><span hx-get="{{ url_for("project_size", name=project.name) }}" hx-trigger="load once">loading...</span></dd>
    <dt class="mui--text-dark-secondary">Members</dt>
      <dd class="details-list__definition">{{ render_members(project, current_user) }}</dd>
      {% if current_user.user_id == project.owner %}
        <dd class="details-list__definition">
          <a href="{{ url_for("project_members", name=project.name) }}">
            <button type="button" class="mui-btn mui-btn--raised">
              Manage project members...
            </button>
          </a>
        </dd>
      {% endif %}
      </dd>
    <dt class="mui--text-dark-secondary">Browse</dt>
      <dd class="details-list__definition">
        <a href="{{ url_for('browse', path=project | canonical_path) }}">{{ project | canonical_path }}</a>
      </dd>
  </dl>

  <h2>Sessions</h2>

  {{ render_datasets(project, datasets, current_user)}}

  {% if current_user.user_id in project.members or current_user.user_id == project.owner %}
    <p>
      <a href="{{ url_for("create_dataset", name=project.name) }}">
        <button type="button" class="mui-btn mui-btn--raised">
          Create session...
        </button>
      </a>
    </p>
  {% endif %}
</div>
{% endblock content %}