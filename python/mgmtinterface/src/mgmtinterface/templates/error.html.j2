{% extends "base.html.j2" %}

{% from "_projecthelpers.html.j2" import navbar_short %}

{% block content %}

{% include '_header.html.j2' %}

<div class="mui-panel">
    {{ navbar_short("Error") }}
    <h1>Error</h1>

    {% include '_flash.html.j2' %}
    {{ result.errno | escape }}: {{ result.message | escape }}

    <p>
        <a href="{{ url_for('index') }}">
            <button class="mui-btn mui-btn--raised">Back to main view</button>
        </a>
    </p>
</div>
{% endblock content %}