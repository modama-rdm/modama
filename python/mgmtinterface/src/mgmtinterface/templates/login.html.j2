{% extends "base.html.j2" %}

{% from "_formhelpers.html.j2" import render_field %}
{% from "_projecthelpers.html.j2" import navbar_short %}

{% block content %}

{% include '_header.html.j2' %}

<div class="mui-panel">
  {{ navbar_short("Login") }}
  <h1>Login</h1>
  {% include '_flash.html.j2' %}
  <p>All members of the 'iff' group in the PGI-JCNS-TA user management
  can access the data management system using their Unix login name and password as credentials.
  </p>
  <form method="post" action=".{% if next_url %}?next={{ next_url }}{% endif %}" class="mui-form">
    {{ form.csrf_token }}
    {{ render_field(form.username) }}
    {{ render_field(form.password) }}
    <p>
      <input
        type=submit
        value="Login"
        class="mui-btn mui-btn--raised"
        onClick="this.form.submit(); this.disabled=true; this.value='Logging in…'; "
      />
    </p>
  </form>
</div>
{% endblock content %}
