# syntax=docker/dockerfile:1.4

FROM rust:slim-bookworm AS builder

WORKDIR /usr/src/modama-rs/

RUN --mount=type=cache,target=/var/cache/apt apt-get update && apt-get -y install clang lld

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry/ --mount=type=cache,target=/usr/src/modama-rs/target/ cargo build --release --bin smbdrop && cp target/release/smbdrop /usr/bin/smbdrop

FROM debian:bookworm-slim

RUN --mount=type=cache,target=/var/cache/apt apt-get update && apt-get -y install samba samba-client winbind strace

# the main samba config
COPY ./smbdrop/smb.conf /etc/samba/smb.conf

RUN mkdir -p /data/adhoc/proj1/session1
RUN chown 1000:1000 -R /data/adhoc/proj1/

EXPOSE 445/tcp
EXPOSE 5051/tcp
EXPOSE 5052/tcp

COPY --from=builder /usr/bin/smbdrop /usr/bin/smbdrop

CMD [ \
    "/usr/bin/smbdrop", \
    "--api-listen=0.0.0.0:5051", \
    "--token-api-listen=0.0.0.0:5053", \
    "--ws-listen=0.0.0.0:5052" \
]

