{% extends "base.html.j2" %}

{% from "_formhelpers.html.j2" import render_field %}
{% from "_projecthelpers.html.j2" import render_datasets, navbar, cancel %}

{% block content %}

{% include '_header.html.j2' %}

<div class="mui-panel">
  {{ navbar(project) }}
  <div class="mui-panel">
    <h1>Create session in project "{{ project['name'] }}"</h1>

    {% include '_flash.html.j2' %}

    <form
        method=post
        action="{{ url_for("create_dataset", name=project.name) }}"
        class="mui-form"
    >
      {{ form.csrf_token }}
      <dl>
        {{ render_field(form.name) }}
      </dl>
      <p>
        <input type="submit" class="mui-btn mui-btn--raised mui-btn--primary" value="Create session">
        {{ cancel(project) }}
      </p>
    </form>
  </div>
  <div class="mui-panel">
    <h2>Current sessions</h2>

    {{ render_datasets(project, datasets, current_user)}}
  </div>
</div>
{% endblock content %}