{% extends "base.html.j2" %}

{% from "_formhelpers.html.j2" import render_field %}

{% block content %}

{% include '_header.html.j2' %}

<h1>Confirm seal dataset "{{ dsname }}" in project "{{ project.name }}"</h1>

<p><a href="{{ url_for("project", name=project.name) }}">Details for "{{ project.name }}"</a></p>
<p><a href="{{ url_for("index") }}">Project overview</a></p>

{{ form.errors }}

<form method=post action="{{ url_for("seal_dataset", name=project.name, dataset=dsname) }}">
  {{ form.csrf_token }}
  <p><input type=submit value="Seal dataset '{{ dsname }}'">
</form>

<h2>Current datasets</h2>

<ul>
  {% for d in datasets %}
    <li>{{ d.name }}</li>
  {% endfor %}
</ul>

{% endblock content %}