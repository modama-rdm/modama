{% from "_formhelpers.html.j2" import render_field %}

{{ createprojectform.errors }}

<form method=post action="/project/add/">
  {{ createprojectform.csrf_token }}
  <dl>
    {{ render_field(createprojectform.name) }}
    {{ render_field(createprojectform.members) }}
    {{ render_field(createprojectform.message) }}
  </dl>
  <p><input type=submit value="Create Project">
</form>
