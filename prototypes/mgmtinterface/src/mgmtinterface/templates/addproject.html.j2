{% extends "base.html.j2" %}

{% from "_formhelpers.html.j2" import render_field %}

{% block content %}

{% include '_header.html.j2' %}

<p><a href="{{ url_for("index") }}">Back to project overview</a></p>

{{ form.errors }}

<form method=post action="{{ url_for("add_project") }}">
  {{ form.csrf_token }}
  <dl>
    {{ render_field(form.name) }}
    {{ render_field(form.members) }}
  </dl>
  <p><input type=submit value="Create Project">
</form>


{% endblock content %}