{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}

<h1>Project {{ project['name'] }}</h1>

<p><a href="/">Back to overview</a></p>

<p>Owner: {{ project.owner }}</p>
<p>Members:
{% for m in project.members %} 
<form method=post action=".">
{{ addmembersform.csrf_token }}
<input id="action" name="action" type="hidden" value="remove">
<input id="members" name="members" type="hidden" value="{{ m }}">
{{ m }}
<input type=submit value="Remove"> 
</form>
{% endfor %}
</p>

<p>Size (Bytes): {{ project.usage_bytes }}</p>


{% from "_formhelpers.html.j2" import render_field %}

{{ addmembersform.errors }}

<form method=post action=".">
  {{ addmembersform.csrf_token }}
  <dl>
    {{ addmembersform.action }}
    {{ render_field(addmembersform.members) }}
    {{ render_field(addmembersform.message) }}
  </dl>
  <p><input type=submit value="Add Members">
</form>

<h2>Datasets</h2>
<table>
<tr>
    <th>Name</th>
    <th>Immutable</th>
</tr>
{% for d in datasets %}
<tr>
    <td>{{ d.name }}</td>
    <td>{{ d.immutable }}</td>
</tr>
{% endfor %}
</table>

{% endblock content %}