{% extends "base.html.j2" %}

{% block content %}
{% include '_header.html.j2' %}

<h1>Project "{{ project.name }}"</h1>

  <p><a href="{{ url_for("index") }}">Project overview</a></p>

  <p>Owner: {{ project.owner }}</p>
  <p>Members:
    {% for m in project.members %}
    {{ m }}<a href="{{ url_for('remove_project_members', name=project.name, member=m) }}">Remove...</a><br/>
    {% endfor %}
  </p>

  <p><a href="{{ url_for("add_project_members", name=project.name) }}">Add project members...</a></p>

  <p>Size (Bytes): {{ project.usage_bytes }}</p>


<h2>Datasets</h2>
<table>
<tr>
    <th>Name</th>
    <th>Immutable</th>
    <th></th>
</tr>
  {% for d in datasets %}
  <tr>
      <td>{{ d.name }}</td>
      <td>{{ d.immutable }}</td>
      {% if d.immutable %}
      <td></td>
      {% else %}
      <td><a href="{{ url_for('seal_dataset', name=project.name, dataset=d.name) }}">Seal...</a></td>
      {% endif %}
  </tr>
  {% endfor %}
</table>

<p><a href="{{ url_for("create_dataset", name=project.name) }}">Create dataset...</a></p>

{% endblock content %}