{% extends "base.html.j2" %}

{% block content %}

{% include '_header.html.j2' %}

<h1>Projects</h1>

<table>
<tr>
    <th>Name</th>
    <th>Owner</th>
    <th>Members</th>
    {# <th>Size</th> #}
</tr>
{% for p in projects %}
<tr>
    <td><a href="/project/details/{{ p.name }}">{{ p.name }}</a></td>
    <td>{{ p.owner }}</td>
    <td>{% for m in p.members %} {{ m }} {% endfor %}</td>
</tr>
{% endfor %}
</table>

<h2>Create Project</h2>

{% include '_createprojectform.html.j2' %}

{% endblock content %}