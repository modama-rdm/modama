{% extends "base.html.j2" %}

{% block content %}

{% include '_header.html.j2' %}

<h1>Projects</h1>

<table>
<tr>
    <th>Name</th>
    <th>Owner</th>
    <th>Members</th>
    {# <th>Size</th> #}
</tr>
{% for p in projects %}
<tr>
    <td><a href="{{ url_for("project", name=p.name) }}">{{ p.name }}</a></td>
    <td>{{ p.owner }}</td>
    <td>{% for m in p.members %} {{ m }} {% endfor %}</td>
</tr>
{% endfor %}
</table>

<p><a href="{{ url_for("add_project") }}">Create Project...</a></p>

{% endblock content %}