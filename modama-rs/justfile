agent_gui_package := "modama-agent-gui"
snapshot_dir := "modama-agent-gui/tests/snapshots"
guide_image_dir := "../docs/guide/src/user/images/agent"
design_spec := "../mgmtinterface-new/DESIGN.md"
win7_toolchain := "nightly-2025-12-11"
xwin_cache := justfile_directory() + "/.xwin-cache"
xwin_sdk := xwin_cache + "/splat"
xwin_cflags := "/imsvc" + xwin_sdk + "/crt/include /imsvc" + xwin_sdk + "/sdk/include/ucrt /imsvc" + xwin_sdk + "/sdk/include/shared /imsvc" + xwin_sdk + "/sdk/include/um"

fmt:
    cargo fmt

clippy:
    cargo clippy -q --all-targets --all-features

fmt-check:
    cargo fmt --check

# Run one component's tests with source-based coverage and generate text, HTML, and JSON reports.
coverage $component:
    #!/usr/bin/env bash
    set -euo pipefail
    case "$component" in
        modama-agent|modama-agent-gui|smbdrop) ;;
        *)
            echo "unknown coverage component: $component" >&2
            echo "expected one of: modama-agent, modama-agent-gui, smbdrop" >&2
            exit 2
            ;;
    esac
    report_dir="target/llvm-cov/$component"
    cargo llvm-cov clean --workspace
    rm -rf -- "$report_dir"
    mkdir -p "$report_dir"
    cargo llvm-cov --package "$component" --no-report --no-fail-fast
    cargo llvm-cov report --package "$component" --show-missing-lines --color never | tee "$report_dir/summary.txt"
    cargo llvm-cov report --package "$component" --html --output-dir "$report_dir"
    cargo llvm-cov report --package "$component" --json --output-path "$report_dir/coverage.json"
    echo "Coverage reports:"
    echo "  text: $report_dir/summary.txt"
    echo "  HTML: $report_dir/html/index.html"
    echo "  JSON: $report_dir/coverage.json"

coverage-modama-agent:
    @just coverage modama-agent

coverage-modama-agent-gui:
    @just coverage modama-agent-gui

coverage-smbdrop:
    @just coverage smbdrop

# Validate the shared design specification, treating warnings as failures.
validate-design:
    #!/usr/bin/env bash
    set -euo pipefail
    npx @google/design.md lint {{ design_spec }} | node -e 'let data = ""; process.stdin.on("data", chunk => data += chunk).on("end", () => { process.stdout.write(data); const report = JSON.parse(data); if (report.summary.errors || report.summary.warnings) process.exitCode = 1; });'

# Regenerate the checked-in local API contract.
update-openapi:
    cargo run --quiet -p modama-agent --bin generate-openapi > modama-agent/openapi.json

# WGPU_DEBUG=0 is a workaround for https://github.com/KhronosGroup/Vulkan-Loader/pull/1866
# (fixed in vulkan sdk v1.4.345; should be in Debian forky)
# 1338b8ee2ad29446297e7368370eecabd4890bec
# Run egui_kittest visual regression tests.
visual-tests:
    WGPU_DEBUG=0 cargo test -p {{ agent_gui_package }} --features visual-tests --no-fail-fast

# Regenerate and compress the screenshots embedded in the user guide.
guide-screenshots:
    WGPU_DEBUG=0 cargo run -p {{ agent_gui_package }} --features guide-screenshots --bin generate-guide-screenshots
    oxipng -o max --strip safe {{ guide_image_dir }}/*.png

# Run the GUI with egui inspection enabled for egui-mcp.
inspect-gui:
    EGUI_INSPECTION=1 xvfb-run --auto-servernum cargo run -p {{ agent_gui_package }} --bin {{ agent_gui_package }} --features inspection

# Run the test-GUI with egui inspection enabled for egui-mcp.
inspect-guitest:
    EGUI_INSPECTION=1 xvfb-run --auto-servernum cargo run -p {{ agent_gui_package }} --bin guitest --features inspection

# Update visual regression test snapshots.
update-snapshots:
    WGPU_DEBUG=0 UPDATE_SNAPSHOTS=true cargo test -p {{ agent_gui_package }} --features visual-tests --no-fail-fast
    oxipng -o max --strip safe {{ snapshot_dir }}/*.png {{ guide_image_dir }}/*.png

# Remove generated visual-test review artifacts.
clean:
    find {{ snapshot_dir }} {{ guide_image_dir }} -maxdepth 1 -type f \( -name '*.new.png' -o -name '*.diff.png' -o -name '*.old.png' \) -delete

# Install the pinned nightly and components required by the Tier 3 target.
win7-install-toolchain:
    rustup toolchain install {{ win7_toolchain }} --profile minimal --component rust-src --component clippy

# Download and package the Microsoft CRT and Windows SDK used by the legacy build.
win7-xwin-splat:
    xwin --accept-license --arch x86_64 --cache-dir "{{ xwin_cache }}" splat --output "{{ xwin_sdk }}"

# Compile and lint the production crates using the Windows 7 MSVC target.
win7-check-msvc:
    #!/usr/bin/env bash
    set -euo pipefail
    test -d "{{ xwin_sdk }}/crt/lib/x86_64" || { echo "xwin sysroot missing; run: just win7-xwin-splat" >&2; exit 1; }
    export CARGO_TARGET_X86_64_WIN7_WINDOWS_MSVC_LINKER=lld-link
    export CC_x86_64_win7_windows_msvc=clang-cl-19
    export CXX_x86_64_win7_windows_msvc=clang-cl-19
    export AR_x86_64_win7_windows_msvc=llvm-lib
    export CFLAGS_x86_64_win7_windows_msvc="{{ xwin_cflags }}"
    export RUSTFLAGS="--cfg windows_slim_errors -C panic=abort -C target-feature=+crt-static -L native={{ xwin_sdk }}/crt/lib/x86_64 -L native={{ xwin_sdk }}/sdk/lib/um/x86_64 -L native={{ xwin_sdk }}/sdk/lib/ucrt/x86_64"
    cargo +{{ win7_toolchain }} check -q -Z build-std=std,panic_abort --target x86_64-win7-windows-msvc -p modama-common --lib --locked
    cargo +{{ win7_toolchain }} clippy -q -Z build-std=std,panic_abort --target x86_64-win7-windows-msvc -p modama-agent --lib --bins --all-features --locked -- -D warnings
    cargo +{{ win7_toolchain }} clippy -q -Z build-std=std,panic_abort --target x86_64-win7-windows-msvc -p modama-agent-gui --lib --bins --locked -- -D warnings

# Build the production Windows 7 SP1 x64 agent with the dedicated Tier 3 target.
win7-build-agent:
    #!/usr/bin/env bash
    set -euo pipefail
    test -d "{{ xwin_sdk }}/crt/lib/x86_64" || { echo "xwin sysroot missing; run: just win7-xwin-splat" >&2; exit 1; }
    export CARGO_TARGET_X86_64_WIN7_WINDOWS_MSVC_LINKER=lld-link
    export CC_x86_64_win7_windows_msvc=clang-cl-19
    export CXX_x86_64_win7_windows_msvc=clang-cl-19
    export AR_x86_64_win7_windows_msvc=llvm-lib
    export CFLAGS_x86_64_win7_windows_msvc="{{ xwin_cflags }}"
    export RUSTFLAGS="--cfg windows_slim_errors -C panic=abort -C target-feature=+crt-static -L native={{ xwin_sdk }}/crt/lib/x86_64 -L native={{ xwin_sdk }}/sdk/lib/um/x86_64 -L native={{ xwin_sdk }}/sdk/lib/ucrt/x86_64"
    cargo +{{ win7_toolchain }} build -q -Z build-std=std,panic_abort -p modama-agent --bin modama-agent --target x86_64-win7-windows-msvc --release --locked
    cargo +{{ win7_toolchain }} build -q -Z build-std=std,panic_abort -p modama-agent-gui --bin modama-agent-gui --target x86_64-win7-windows-msvc --release --locked

# Require both binaries' DLL imports to belong to the reviewed Windows 7 allowlist.
win7-check-agent-imports: win7-build-agent
    #!/usr/bin/env bash
    set -euo pipefail
    for binary in modama-agent.exe modama-agent-gui.exe; do
        binary="target/x86_64-win7-windows-msvc/release/$binary"
        allowlist="windows-7-dlls.txt"
        imports="$(llvm-readobj --coff-imports "$binary")"
        imported_dlls="$(printf '%s\n' "$imports" | sed -n 's/^  Name: //p' | tr '[:upper:]' '[:lower:]' | LC_ALL=C sort -u)"
        unexpected_dlls="$(comm -13 "$allowlist" <(printf '%s\n' "$imported_dlls"))"
        if [[ -n "$unexpected_dlls" ]]; then
            printf 'Unexpected Windows DLL imports in %s:\n%s\n' "$binary" "$unexpected_dlls" >&2
            echo "Unexpected Windows DLL imports. Verify Windows 7 availability, then update $allowlist deliberately." >&2
            exit 1
        fi
        if grep -Eq 'Symbol: (RoOriginateErrorW|SetThreadDescription|GetSystemTimePreciseAsFileTime|WaitOnAddress|WakeByAddressSingle)' <<<"$imports"; then
            echo "$binary imports a known post-Windows-7 API." >&2
            exit 1
        fi
        echo "Windows 7 import allowlist passed for $binary"
    done

win7-check-gnu:
    #!/usr/bin/env bash
    # needs gcc-mingw-w64-x86-64-win32
    set -euo pipefail
    export RUSTFLAGS="--cfg windows_slim_errors -C target-feature=+crt-static"
    cargo +{{ win7_toolchain }} clippy -q -Z build-std=std,panic_abort --target x86_64-win7-windows-gnu -p modama-agent -p modama-agent-gui --lib --bins --all-features --locked -- -D warnings

# Backwards-compatible name retained for existing local invocations.
win-clippy-gnu: win7-check-gnu

# Run the GIO backend against real GVfs and a Samba container (needs gvfs-backends, gvfs-fuse
# and a D-Bus session; mounts briefly appear in this user session).
gio-integration-test:
    #!/usr/bin/env bash
    set -euo pipefail
    podman build -q -t modama-gio-samba modama-agent/tests/gio-samba >/dev/null
    podman rm -f modama-gio-samba >/dev/null 2>&1 || true
    podman run -d --rm --name modama-gio-samba -p 127.0.0.1:1445:1445 modama-gio-samba >/dev/null
    cleanup() {
        for uri in smb://localhost:1445/ingest/ smb://localhost:1445/ingest2/ smb://127.0.0.1:1445/other/; do
            gio mount -u "$uri" >/dev/null 2>&1 || true
        done
        podman stop modama-gio-samba >/dev/null 2>&1 || true
    }
    trap cleanup EXIT
    for _ in $(seq 1 60); do
        if (exec 3<>/dev/tcp/127.0.0.1/1445) 2>/dev/null; then break; fi
        sleep 0.5
    done
    cargo test -q -p modama-agent --test gio_integration -- --ignored --test-threads=1
