agent_gui_package := "modama-agent-gui"
snapshot_dir := "modama-agent-gui/tests/snapshots"
design_spec := "../mgmtinterface-new/DESIGN.md"

fmt:
    cargo fmt

# Validate the shared design specification, treating warnings as failures.
validate-design:
    #!/usr/bin/env bash
    set -euo pipefail
    npx @google/design.md lint {{ design_spec }} | node -e 'let data = ""; process.stdin.on("data", chunk => data += chunk).on("end", () => { process.stdout.write(data); const report = JSON.parse(data); if (report.summary.errors || report.summary.warnings) process.exitCode = 1; });'

# Regenerate the checked-in local API contract.
update-openapi:
    cargo run --quiet -p modama-agent --bin generate-openapi > modama-agent/openapi.json

# WGPU_DEBUG=0 is a workaround for https://github.com/KhronosGroup/Vulkan-Loader/pull/1866
# (fixed in vulkan sdk v1.4.345; should be in Debian forky)
# 1338b8ee2ad29446297e7368370eecabd4890bec
# Run egui_kittest visual regression tests.
visual-tests:
    WGPU_DEBUG=0 cargo test -p {{ agent_gui_package }} --features visual-tests --no-fail-fast

# Run the GUI with egui inspection enabled for egui-mcp.
inspect-gui:
    EGUI_INSPECTION=1 xvfb-run --auto-servernum cargo run -p {{ agent_gui_package }} --bin {{ agent_gui_package }} --features inspection

# Update visual regression test snapshots.
update-snapshots:
    UPDATE_SNAPSHOTS=true cargo test -p {{ agent_gui_package }} --features visual-tests --no-fail-fast
    oxipng -o max --strip safe {{ snapshot_dir }}/*.png

# Remove generated visual-test review artifacts.
clean:
    find {{ snapshot_dir }} -maxdepth 1 -type f \( -name '*.new.png' -o -name '*.diff.png' -o -name '*.old.png' \) -delete
