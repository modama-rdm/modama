# syntax=docker/dockerfile:1.4

FROM rust:slim-trixie AS chef

WORKDIR /usr/src/modama-rs/

RUN --mount=type=cache,sharing=locked,target=/var/cache/apt apt-get update && apt-get -y install clang lld

RUN cargo install cargo-chef --locked --version 0.1.78

# The recipe holds the workspace's manifests and lockfile, so the dependency build below stays
# cached, also in CI, until one of those changes. target/ and the cargo registry are not cache
# mounts: the dependency build has to land in an image layer, which CI caches.
FROM chef AS planner

COPY . .

RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /usr/src/modama-rs/recipe.json recipe.json

# The recipe has only workspace members, but the [patch.crates-io] paths in Cargo.toml must exist
# for cargo to resolve the workspace.
COPY vendor/ vendor/

RUN cargo chef cook --release --locked --bin smbdrop --recipe-path recipe.json

COPY . .

RUN cargo build --release --locked --bin smbdrop && cp target/release/smbdrop /usr/bin/smbdrop

FROM debian:trixie-slim

RUN --mount=type=cache,sharing=locked,target=/var/cache/apt apt-get update && apt-get -y install curl samba samba-client winbind strace

# the main samba config
COPY ./smbdrop/smb.conf /etc/samba/smb.conf

# Samba:
EXPOSE 445/tcp
# HTTP(s) API:
EXPOSE 5051/tcp
# WS API:
EXPOSE 5052/tcp
# Token API:
EXPOSE 5053/tcp

COPY --from=builder /usr/bin/smbdrop /usr/bin/smbdrop

HEALTHCHECK --interval=10s --timeout=15s --start-period=10s --retries=3 CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "12", "http://127.0.0.1:5051/health/"]

CMD [ "/usr/bin/smbdrop", \
    "--ca-cert=/certs/ca/pub/ca.cert.pem", \
    "--chain=/certs/servers/smbdrop/smbdrop.chain.pem", \
    "--privkey=/certs/servers/smbdrop/smbdrop.priv.pem", \
    "--api-listen=0.0.0.0:5051", \
    "--ws-listen=0.0.0.0:5052", \
    "--token-api-listen=0.0.0.0:5053" ]
