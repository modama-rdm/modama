# syntax=docker/dockerfile:1.4

FROM rust:slim-trixie AS builder

WORKDIR /usr/src/modama-rs/

RUN --mount=type=cache,sharing=locked,target=/var/cache/apt apt-get update && apt-get -y install clang curl lld samba samba-client winbind strace
RUN mkdir /etc/smbdrop/

COPY . .
COPY ./smbdrop/smb.conf /etc/samba/smb.conf

CMD [ "cargo" ]
